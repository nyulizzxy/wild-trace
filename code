function drawSceneBackground(loc, x, y, w, h) {
  noStroke();

  // ground
  fill(50, 65, 52);
  rect(x, y + h * 0.62, w, h * 0.38);

  if (loc === "woods" || loc === "corridor") {
    for (let i = 0; i < 6; i++) {
      let tx = x + i * (w / 5);

      fill(30, 43, 32);
      rect(tx, y, 14, h * 0.72);

      fill(60, 82, 60);
      ellipse(tx + 5, y + 20, 80, 85);
    }
  }

  if (loc === "wetland") {
    fill(65, 88, 80);
    rect(x, y + h * 0.58, w, h * 0.42);

    stroke(125, 150, 120);
    strokeWeight(2);
    for (let i = 0; i < 16; i++) {
      let px = x + (i * 31) % w;
      line(px, y + h * 0.65, px + 3, y + h * 0.47);
    }
    noStroke();
  }

  if (loc === "farm") {
    stroke(115, 125, 90);
    for (let i = 0; i < 8; i++) {
      let yy = y + h * 0.60 + i * 11;
      line(x, yy, x + w, yy);
    }
    noStroke();
  }

  if (loc === "creek") {
    fill(70, 96, 93);
    beginShape();
    vertex(x, y + h * 0.70);
    vertex(x + w * 0.40, y + h * 0.58);
    vertex(x + w, y + h * 0.70);
    vertex(x + w, y + h);
    vertex(x, y + h);
    endShape(CLOSE);
  }

  if (loc === "ridge") {
    fill(45, 55, 45);
    triangle(
      x,
      y + h * 0.72,
      x + w * 0.40,
      y + h * 0.22,
      x + w * 0.75,
      y + h * 0.72
    );
  }

  if (loc === "site") {
    fill(79, 75, 64);
    rect(x, y + h * 0.55, w, h * 0.45);

    stroke(120);
    strokeWeight(2);
    line(x + w * 0.15, y + h * 0.55, x + w * 0.85, y + h * 0.75);
    noStroke();
  }
}

