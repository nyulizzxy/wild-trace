  fill(240, 235, 220);
  stroke(20, 20, 20, 80);
  strokeWeight(2);
  rect(x, y, w, h, 5);

  noStroke();

  drawScene(
    p,
    x + 18,
    y + 18,
    w - 36,
    h - 115
