function drawConstructionProgress() {
  let stages = [
    0,
    45,
    105,
    165,
    235
  ];

  let size = stages[night - 1];

  if (size > 0) {
    fill(190, 175, 150);
    rect(755, 335, size, 70, 8);
  }

  // survey stakes
  if (night >= 2) {
    stroke(190, 80, 60);
    strokeWeight(4);

    for (let i = 0; i < night; i++) {
      let x = 750 + i * 50;
      line(x, 315, x, 355);
    }
  }

  // fence grows visually
  if (night >= 3) {
    let segments = night - 2;

    stroke(80);
    strokeWeight(3);

    for (let i = 0; i < segments * 3; i++) {
      let x = 710 + i * 30;
      line(x, 355, x, 410);
      line(x, 370, x + 30, 385);
      line(x, 385, x + 30, 370);
    }
  }

  noStroke();
}

function drawSiteMarker(s) {
  let chosen = selectedSites.includes(s.id);

  stroke(chosen ? color(255, 206, 75) : color(245));
  strokeWeight(chosen ? 6 : 3);

  fill(chosen ? color(48, 55, 46) : color(50, 60, 50, 210));
  ellipse(s.x, s.y, 58);

  noStroke();

  if (chosen) {
    drawTinyCamera(s.x, s.y, false, 0.7);
  } else {
    fill(240);
    ellipse(s.x, s.y, 8);
  }

  fill(25, 30, 25, 210);
  rect(s.x - 40, s.y + 34, 80, 22, 5);

  fill(245);
  textAlign(CENTER, CENTER);
  textSize(10);
  text(s.name, s.x, s.y + 45);
}

// ============================================================
// NIGHT
// ============================================================

function beginNight() {
  tonightPhotos = [];
  flashTimes = [];
  nightResolved = false;

  for (let id of selectedSites) {
    let ev = events[night][id];

    tonightPhotos.push({
      id: nextPhotoId++,
      night,
      loc: id,
      time: ev.time,
      scene: ev.scene,
      tags: [...ev.tags],
      p: ev.p
    });

    flashTimes.push(-9999);
  }

  nightStart = millis();
  state = "night";
}

function drawNight() {
  drawReserveMap();

  // darkness
  fill(5, 12, 18, 205);
  rect(0, 0, width, height);

  let progress = constrain(
    (millis() - nightStart) / nightDuration,
    0,
    1
  );

  // stars
  noStroke();
  fill(230, 240, 245, 170);

  for (let i = 0; i < 55; i++) {
    let sx = (i * 211) % width;
    let sy = (i * 79) % 290;
    ellipse(sx, sy, 2);
  }

  // moon
  fill(230, 230, 205);
  ellipse(1100, 90, 58);

  // clock
  let totalMinutes = floor(progress * 600);
  let hour = (20 + floor(totalMinutes / 60)) % 24;
  let minute = totalMinutes % 60;

  let clock =
    nf(hour, 2) + ":" + nf(minute, 2);

  fill(255);
  textAlign(CENTER);
  textSize(30);
  text(clock, width / 2, 55);

  // camera activations
  for (let i = 0; i < tonightPhotos.length; i++) {
    let p = tonightPhotos[i];

    if (progress >= p.p && flashTimes[i] < 0) {
      flashTimes[i] = millis();
    }

    if (
      flashTimes[i] > 0 &&
      millis() - flashTimes[i] < 450
    ) {
      let site = getSite(p.loc);

      let pulse =
        map(
          millis() - flashTimes[i],
          0,
          450,
          110,
          10
        );

      noFill();
      stroke(255, 245, 190, 210);
      strokeWeight(5);
      ellipse(site.x, site.y, pulse);

      noStroke();
      fill(255, 250, 210, 220);
      ellipse(site.x, site.y, 28);
    }
  }

  // progress bar
  noStroke();
  fill(255, 255, 255, 40);
  rect(250, 700, 700, 5);

  fill(235);
  rect(250, 700, 700 * progress, 5);

  if (progress >= 1 && !nightResolved) {
    nightResolved = true;

    setTimeout(() => {
      collectedPhotos.push(...tonightPhotos);

      if (
        night === 3 &&
        selectedSites.includes("site")
      ) {
        lostCamera = true;
      }

      state = "review";
    }, 500);
  }
}

