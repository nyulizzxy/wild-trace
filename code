// ============================================================
// HELPERS
// ============================================================

function getSite(id) {
  return sites.find(s => s.id === id);
}

function hit(x, y, w, h) {
  return (
    mouseX >= x &&
    mouseX <= x + w &&
    mouseY >= y &&
    mouseY <= y + h
  );
}

function blob(x, y, w, h) {
  ellipse(x, y, w, h);
}
